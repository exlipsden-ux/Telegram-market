# Скопируйте этот файл в .env и заполните значения.

# Токен бота из @BotFather — этот бот продаёт VPN
BOT_TOKEN=

# Токен второго бота из @BotFather — этот продаёт звёзды.
# Общие база данных, баланс, провайдеры оплаты и админ-панель — только
# Telegram-аккаунт у ботов разный.
STARS_BOT_TOKEN=

# Публичный HTTPS-адрес витрины (Mini App).
# Локальный http://localhost:8080 Telegram не примет — нужен туннель.
WEBAPP_URL=

# Токен приложения Crypto Pay: @CryptoBot -> Crypto Pay -> Create App.
# Там же в настройках приложения укажите Webhook URL:
#   <адрес витрины>/cryptobot/webhook
CRYPTOBOT_TOKEN=

# Robokassa (из кабинета магазина). Result URL в настройках магазина:
#   <адрес витрины>/robokassa/result
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST=1

# Lolz Market (lzt.market): API-клиент со скоупом invoice —
# https://lolz.live/account/api/client-add, токен через .../get-token.
# merchant_id — из раздела платежей на lzt.market.
LOLZ_TOKEN=
LOLZ_MERCHANT_ID=

# PayCore (СБП/карта, вывод в USDT): бот @PayCoreWallet_Bot -> "🔑 API токен".
PAYCORE_API_KEY=

# Оплата в TON напрямую на свой кошелёк — без провайдера, без вебхука.
# Курс TON/RUB берётся live с CoinGecko, оплата подтверждается автоматически
# опросом toncenter.com (раз в 25 сек) по комментарию "order-<id>".
TON_WALLET_ADDRESS=
# Необязательно: ключ toncenter.com для более высокого рейт-лимита опроса.
TON_API_KEY=

# Telegram ID администраторов через запятую
ADMIN_IDS=

# Файл базы данных
DB_PATH=shop.db
